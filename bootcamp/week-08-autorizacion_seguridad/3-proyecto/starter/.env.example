PORT=3000
NODE_ENV=development

# MongoDB — levantar con: docker compose up -d
MONGODB_URI=mongodb://localhost:27017/proyecto-semana-08

# JWT — generar cada uno con: openssl rand -base64 64
# Deben ser DISTINTOS y de al menos 32 caracteres (el servidor no arranca si no)
JWT_ACCESS_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio_access
JWT_REFRESH_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio_refresh

# CORS — origenes permitidos separados por coma (nunca *)
CORS_ORIGINS=http://localhost:5173,http://localhost:3001

# Cookies — secure=true por defecto (localhost cuenta como origen seguro)
COOKIE_SECURE=true

# Seed (pnpm seed) — usuarios de prueba; cambia las contraseñas
SEED_ADMIN_EMAIL=admin@mercadocampesino.co
SEED_ADMIN_PASSWORD=CambiaEsta2026
SEED_SELLER_EMAIL=dona.rosa@mercadocampesino.co
SEED_SELLER_PASSWORD=CambiaEsta2026
